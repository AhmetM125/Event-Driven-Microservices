# ===================================================================
# EventDrivenShop Environment Variables (Local Development Template)
# Copy this file to .env for local docker-compose configuration
# ===================================================================

# PostgreSQL Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# RabbitMQ Infrastructure
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Service Ports
ORDER_SERVICE_HTTP_PORT=5001
PAYMENT_SERVICE_HTTP_PORT=5002
NOTIFICATION_SERVICE_HTTP_PORT=5003

# OpenTelemetry (Optional Jaeger / OTLP Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=EventDrivenShop
